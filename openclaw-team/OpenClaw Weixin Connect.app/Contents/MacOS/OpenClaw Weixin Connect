#!/usr/bin/env bash
set -euo pipefail

APP_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
RUNNER="$APP_DIR/Resources/connect-openclaw-weixin.command"

chmod +x "$RUNNER" 2>/dev/null || true

osascript <<APPLESCRIPT
tell application "Terminal"
  activate
  do script quoted form of "$RUNNER"
end tell
APPLESCRIPT
